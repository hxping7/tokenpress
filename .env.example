# TokenPress Environment Configuration
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development

# JWT Secret - CHANGE THIS IN PRODUCTION!
JWT_SECRET=your-jwt-secret-change-in-production

# Revalidate Secret - CHANGE THIS IN PRODUCTION!
REVALIDATE_SECRET=your-revalidate-secret-change-in-production

# Site URL
SITE_URL=http://localhost:8081

# Frontend URL
FRONTEND_URL=http://localhost:8081

# API URL (public path)
# Leave empty to use relative path (recommended for Docker/production)
# Set to http://localhost:4001 if you need direct API access
NEXT_PUBLIC_API_URL=

# Next.js Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:8081

# Optional: Umami Analytics Share URL
# NEXT_PUBLIC_UMAMI_SHARE_URL=

# Docker ports (for production)
HTTP_PORT=8080
HTTPS_PORT=8443