# TokenPress Environment Configuration
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development

# JWT Secret - 生产环境必填，缺失或长度不足 32 位时后端拒绝启动。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Revalidate Secret - 前后端共用，生产环境必填；缺失时前端拒绝全部缓存刷新请求。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# Site URL
SITE_URL=http://localhost:8081

# Frontend URL（**对外**地址，供 CORS / referer 白名单使用）
FRONTEND_URL=http://localhost:8081

# 容器内互调地址（后端 → 前端 缓存刷新），docker compose 已写死为
# http://frontend:4000；仅在自建编排/非容器部署时才需要显式覆盖。
# FRONTEND_INTERNAL_URL=http://frontend:4000

# API URL (public path)
# Leave empty to use relative path (recommended for Docker/production)
# Set to http://localhost:4001 if you need direct API access
NEXT_PUBLIC_API_URL=

# Next.js Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:8081

# Optional: Umami Analytics Share URL
# NEXT_PUBLIC_UMAMI_SHARE_URL=

# Docker ports (for production)
HTTP_PORT=8080
HTTPS_PORT=8443