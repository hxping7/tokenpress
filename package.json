    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "feed": "^5.2.1",
    "sonner": "^2.0.7",
    "tailwindcss": "3.4.16"
