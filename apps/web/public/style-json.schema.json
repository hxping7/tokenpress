{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "style-json.schema.json",
  "title": "TokenPress Style Pack",
  "description": "风格包单文件 style.json 的结构与校验规则。AI Agent 通过 GET /api/v1/styles/:id/schema 读取本 schema，理解可配置字段与合法取值。",
  "type": "object",
  "properties": {
    "$": {
      "type": "object",
      "description": "元数据（只读，AI 不可通过 patch 修改根 $）",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "preview": {
          "type": "string"
        },
        "builtin": {
          "type": "boolean"
        },
        "defaultTheme": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "night",
            "cyber",
            "lava",
            "space"
          ]
        },
        "compatibleThemes": {
          "type": "array",
          "description": "兼容墙纸白名单：声明前台配色切换器中允许出现的墙纸 key。省略或空数组=全部内置主题均可切换。深品牌色与深墙纸会撞色时，应只列浅色墙纸（如 light）。",
          "items": {
            "type": "string",
            "enum": [
              "night",
              "cyber",
              "lava",
              "light",
              "space"
            ]
          }
        }
      }
    },
    "design": {
      "type": "object",
      "description": "设计令牌 + 出厂配色。明暗/墙纸由全局主题（activeTheme）决定，包不声明；tokens 为出厂 :root CSS 变量（品牌色不会被主题覆盖）；theme 为完整 theme.css（兼容注入）。",
      "properties": {
        "tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "theme": {
          "type": "string"
        }
      }
    },
    "header": {
      "type": "object",
      "description": "顶部导航栏配置",
      "properties": {
        "variant": {
          "type": "string",
          "enum": [
            "sticky-solid",
            "sticky-glass",
            "sticky-transparent",
            "static",
            "hidden"
          ]
        },
        "height": {
          "type": "number"
        },
        "logo": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "image",
                "text",
                "component"
              ]
            },
            "src": {
              "type": "string"
            },
            "srcLight": {
              "type": "string"
            },
            "text": {
              "type": "string",
              "description": "文字 Logo 的兜底文案。站点名称唯一来源是 site_settings.site_name，本字段仅在站点名为空时生效，禁止在此写死站点品牌名"
            },
            "position": {
              "type": "string",
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "height": {
              "type": "number"
            },
            "link": {
              "type": "string"
            }
          }
        },
        "nav": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "sections",
                "custom",
                "mixed"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "customItems": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "align": {
              "type": "string",
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "style": {
              "type": "string",
              "enum": [
                "plain",
                "pill",
                "underline"
              ]
            },
            "position": {
              "type": "string",
              "enum": [
                "top",
                "left"
              ]
            },
            "icons": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "showIcon": {
              "type": "boolean"
            },
            "dropdown": {
              "type": "string",
              "enum": [
                "hover",
                "click"
              ]
            },
            "colors": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "background": {
          "type": "string"
        },
        "borderBottom": {
          "type": "string"
        }
      }
    },
    "hero": {
      "type": "object",
      "description": "首页 Hero 配置",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "size": {
          "type": "string"
        },
        "autoplay": {
          "type": "boolean"
        },
        "interval": {
          "type": "number"
        },
        "showCTA": {
          "type": "boolean"
        },
        "ctaButtons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": [
                  "string",
                  "object"
                ]
              },
              "href": {
                "type": "string"
              },
              "style": {
                "type": "string",
                "enum": [
                  "primary",
                  "outline",
                  "ghost"
                ]
              }
            }
          }
        }
      }
    },
    "layouts": {
      "type": "object",
      "description": "布局配置（含首页组件序列、板块/分类/文章布局、模板级默认）",
      "properties": {
        "homepage": {
          "type": "object",
          "properties": {
            "container": {
              "type": "string",
              "enum": [
                "boxed",
                "full",
                "wide"
              ]
            },
            "sections": {
              "type": "array",
              "description": "首页组件序列（动态注册表：Hero/Features/ArticleList/CTA/Banner/CustomBlock）",
              "items": {
                "type": "object",
                "properties": {
                  "component": {
                    "type": "string",
                    "enum": [
                      "Hero",
                      "Features",
                      "ArticleList",
                      "CTA",
                      "Banner",
                      "CustomBlock"
                    ]
                  },
                  "variant": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "props": {
                    "type": "object"
                  }
                },
                "required": [
                  "component"
                ]
              }
            }
          }
        },
        "section": {
          "type": "object",
          "properties": {
            "layout": {
              "type": "string",
              "enum": [
                "page-sidebar-right",
                "page-sidebar-left",
                "landing",
                "none"
              ]
            },
            "hero": {
              "type": "object"
            },
            "sidebar": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "sticky": {
                  "type": "boolean"
                }
              }
            },
            "list": {
              "type": "object"
            },
            "subcategory": {
              "type": "object",
              "description": "二级分类配置",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "position": {
                  "type": "string",
                  "enum": [
                    "sidebar",
                    "top",
                    "tab",
                    "none"
                  ]
                },
                "style": {
                  "type": "string",
                  "enum": [
                    "pill",
                    "card",
                    "list",
                    "grid"
                  ]
                },
                "columns": {
                  "type": "number"
                },
                "showCount": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "category": {
          "type": "object"
        },
        "article": {
          "type": "object"
        },
        "list": {
          "type": "object"
        },
        "templates": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "description": "页脚装修配置。只定义布局/网格/间距/字号/显隐；导航链接、版权、备案、友链数据等内容一律来自 site_settings 与 friend_links 表，本根键下不得出现任何内容",
      "properties": {
        "variant": {
          "type": "string",
          "enum": [
            "multi-column",
            "simple",
            "minimal"
          ],
          "description": "multi-column 导航网格+友链+版权区；simple 单行（版权 | 备案+Powered by）；minimal 居中 Logo+版权"
        },
        "padding": {
          "type": "string",
          "description": "区块内边距 CSS 值，默认 2rem 1rem"
        },
        "maxWidth": {
          "type": "string",
          "description": "内容最大宽度，默认 var(--content-max-width)"
        },
        "borderTop": {
          "type": [
            "string",
            "boolean"
          ],
          "description": "页脚顶部边线 CSS 值；false 关闭"
        },
        "nav": {
          "type": "object",
          "description": "导航网格区（内容来自 site_settings.footer_nav）",
          "properties": {
            "columns": {
              "type": "number",
              "description": "列数；缺省时取 site_settings.footer_nav_columns"
            },
            "template": {
              "type": "string",
              "description": "直接给 grid-template-columns（如 1.5fr 1fr 1fr 1fr），优先于 columns"
            },
            "gap": {
              "type": "string"
            },
            "align": {
              "type": "string",
              "enum": [
                "start",
                "center"
              ]
            },
            "divider": {
              "type": [
                "string",
                "boolean"
              ],
              "description": "友链区上分隔线 CSS 值；false 关闭"
            },
            "responsive": {
              "type": [
                "object",
                "boolean"
              ],
              "description": "断点列数 {md,lg}；false 关闭响应式，始终使用 template/columns",
              "properties": {
                "md": {
                  "type": "number"
                },
                "lg": {
                  "type": "number"
                }
              }
            },
            "title": {
              "type": "object",
              "description": "分组标题样式",
              "properties": {
                "size": {
                  "type": "string"
                },
                "weight": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "transform": {
                  "type": "string",
                  "enum": [
                    "none",
                    "uppercase",
                    "capitalize"
                  ]
                },
                "letterSpacing": {
                  "type": "string"
                },
                "marginBottom": {
                  "type": "string"
                },
                "color": {
                  "type": "string"
                }
              }
            },
            "link": {
              "type": "object",
              "description": "链接样式",
              "properties": {
                "size": {
                  "type": "string"
                },
                "lineHeight": {
                  "type": "string"
                },
                "gap": {
                  "type": "string"
                }
              }
            }
          }
        },
        "brandBlock": {
          "type": "object",
          "description": "首列品牌块：Logo + 站点简介。文案取自 site_settings，包只决定显隐/来源/字号",
          "properties": {
            "show": {
              "type": "boolean"
            },
            "source": {
              "type": "string",
              "enum": [
                "siteDescription",
                "siteName"
              ]
            },
            "size": {
              "type": "string"
            },
            "lineHeight": {
              "type": "string"
            }
          }
        },
        "logo": {
          "type": "object",
          "properties": {
            "show": {
              "type": "boolean"
            },
            "height": {
              "type": "string"
            }
          }
        },
        "friendLinks": {
          "type": "object",
          "description": "友链展示控制（数据来自 friend_links 表，不含任何链接数据）",
          "properties": {
            "show": {
              "type": "boolean"
            },
            "maxItems": {
              "type": "number"
            },
            "title": {
              "type": "string"
            },
            "layout": {
              "type": "string",
              "enum": [
                "inline",
                "grid"
              ]
            },
            "columns": {
              "type": "number"
            },
            "gap": {
              "type": "string"
            },
            "titleSize": {
              "type": "string"
            }
          }
        },
        "bottom": {
          "type": "object",
          "description": "版权区（版权/备案/Powered by 文案全部来自 site_settings）",
          "properties": {
            "show": {
              "type": "boolean"
            },
            "layout": {
              "type": "string",
              "enum": [
                "columns",
                "between",
                "centered"
              ]
            },
            "size": {
              "type": "string"
            },
            "gap": {
              "type": "string"
            },
            "divider": {
              "type": [
                "string",
                "boolean"
              ]
            },
            "showIcp": {
              "type": "boolean"
            },
            "showPoweredBy": {
              "type": "boolean"
            }
          }
        },
        "background": {
          "type": "string"
        },
        "textColor": {
          "type": "string"
        }
      }
    },
    "features": {
      "type": "object",
      "description": "行为特性开关",
      "properties": {
        "readingProgressBar": {
          "type": "boolean"
        },
        "backToTop": {
          "type": "boolean"
        },
        "welcomeOverlay": {
          "type": "boolean"
        },
        "languageSwitcher": {
          "type": "string",
          "enum": [
            "icon",
            "label",
            "full"
          ]
        }
      }
    }
  }
}
