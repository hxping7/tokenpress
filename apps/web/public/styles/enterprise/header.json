{
  "variant":"sticky-solid",
  "logo": {
    "type":"image",
    "src":"/logo.svg",
    "text":"TokenPress",
    "position":"left",
    "height":60,
    "link":"/"
  },
  "nav":  { "align":"right", "style":"pill", "source":"sections", "customItems":[],
    "colors": {
      "text":"var(--text-primary)",
      "hoverBg":"var(--hover-bg)",
      "hoverText":"var(--text-primary)",
      "activeBg":"#4f46e5",
      "activeText":"#ffffff",
      "barBg":"transparent",
      "barText":"var(--text-primary)"
    } },
  "actions": [
    { "type":"theme", "icon":"palette", "style":"icon" },
    { "type":"language", "icon":"globe", "style":"ghost", "label":{"zh":"中文","en":"EN"} },
    { "type":"link", "icon":"message", "label":{"zh":"联系我们","en":"Contact"}, "style":"primary", "href":"/articles" },
    { "type":"admin", "icon":"dashboard", "style":"ghost", "showWhen":"loggedIn" },
    { "type":"logout", "icon":"logout", "style":"ghost", "showWhen":"loggedIn" },
    { "type":"login", "icon":"user", "style":"outline", "showWhen":"loggedOut" }
  ],
  "background":"var(--bg-primary)",
  "borderBottom":"1px solid var(--border-color)"
}
