{
  "$": {
    "id": "enterprise",
    "name": "科技企业官网 · 活力版",
    "description": "融合「科技 + 创新 + 活力」的企业官网风格：暖白底 + 高对比深色块，橙红主强调 / 靛紫次强调 / 青色科技点缀，大字号粗标题、20px 大圆角、三色渐变 CTA、四列页脚（含 ICP 备案）。",
    "version": "1.2.0",
    "author": "token00",
    "preview": "/styles/enterprise/preview.png",
    "builtin": true,
    "defaultTheme": "light",
    "compatibleThemes": [
      "light"
    ],
    "tags": [
      "enterprise",
      "corporate",
      "business",
      "tech",
      "innovation",
      "energy"
    ]
  },
  "design": {
    "tokens": {
      "--bg-primary": "#FFF7F2",
      "--bg-secondary": "#FFFFFF",
      "--bg-tertiary": "#FFEDE0",
      "--text-primary": "#1A1206",
      "--text-secondary": "#6A5A49",
      "--text-muted": "#A08A76",
      "--accent-blue": "#FF5A2B",
      "--accent-purple": "#7C4DF0",
      "--accent-blue-dim": "#E04A1E",
      "--border-color": "#F1DCCB",
      "--hover-bg": "rgba(255,90,43,0.08)",
      "--gradient-from": "#0EA5B7",
      "--gradient-via": "#7C4DF0",
      "--gradient-to": "#FF5A2B",
      "--grid-pattern": "transparent",
      "--selection-bg": "rgba(255,90,43,0.18)",
      "--scrollbar-thumb": "rgba(255,90,43,0.3)",
      "--scrollbar-thumb-hover": "rgba(255,90,43,0.5)",
      "--focus-ring": "rgba(255,90,43,0.5)",
      "--card-border-hover": "rgba(255,90,43,0.45)",
      "--section-divider": "#F1DCCB",
      "--btn-glow-from": "rgba(255,90,43,0.32)",
      "--btn-glow-to": "rgba(255,176,32,0.28)",
      "--content-max-width": "1180px",
      "--reading-max-width": "760px",
      "--header-height": "76px",
      "--brand-font": "Inter, \"PingFang SC\", system-ui, sans-serif",
      "--radius-card": "20px",
      "--shadow-card": "0 12px 30px rgba(255,90,43,0.14)"
    },
    "theme": ":root{\n  --bg-primary:#FFF7F2;\n  --bg-secondary:#FFFFFF;\n  --bg-tertiary:#FFEDE0;\n  --text-primary:#1A1206;\n  --text-secondary:#6A5A49;\n  --text-muted:#A08A76;\n  --accent-blue:#FF5A2B;\n  --accent-purple:#7C4DF0;\n  --accent-blue-dim:#E04A1E;\n  --border-color:#F1DCCB;\n  --hover-bg:rgba(255,90,43,0.08);\n  --gradient-from:#0EA5B7;\n  --gradient-via:#7C4DF0;\n  --gradient-to:#FF5A2B;\n  --grid-pattern:transparent;\n  --selection-bg:rgba(255,90,43,0.18);\n  --scrollbar-thumb:rgba(255,90,43,0.3);\n  --scrollbar-thumb-hover:rgba(255,90,43,0.5);\n  --focus-ring:rgba(255,90,43,0.5);\n  --card-border-hover:rgba(255,90,43,0.45);\n  --section-divider:#F1DCCB;\n  --btn-glow-from:rgba(255,90,43,0.32);\n  --btn-glow-to:rgba(255,176,32,0.28);\n  --content-max-width:1180px;\n  --reading-max-width:760px;\n  --header-height:76px;\n  --brand-font:Inter, \"PingFang SC\", system-ui, sans-serif;\n  --radius-card:20px;\n  --shadow-card:0 12px 30px rgba(255,90,43,0.14);\n}"
  },
  "header": {
    "variant": "sticky-glass",
    "height": 76,
    "logo": {
      "type": "text",
      "text": "TokenPress",
      "position": "left",
      "height": 32,
      "link": "/"
    },
    "nav": {
      "source": "sections",
      "align": "right",
      "style": "plain",
      "icons": {},
      "colors": {
        "text": "#6A5A49",
        "hoverBg": "transparent",
        "hoverText": "#1A1206",
        "activeBg": "transparent",
        "activeText": "#FF5A2B",
        "barBg": "rgba(255,247,242,0.9)",
        "barText": "#1A1206"
      }
    },
    "actions": [
      {
        "type": "language",
        "icon": "globe",
        "style": "ghost",
        "label": {
          "zh": "中文",
          "en": "EN"
        }
      },
      {
        "type": "theme",
        "icon": "palette",
        "style": "icon"
      }
    ],
    "background": "#ffffff",
    "borderBottom": "2px solid #F1DCCB"
  },
  "hero": {
    "enabled": true,
    "autoplay": true,
    "showCTA": true
  },
  "layouts": {
    "homepage": {
      "container": "full",
      "sections": [
        {
          "component": "Hero",
          "variant": "split",
          "props": {
            "background": "#FFEDE0",
            "eyebrow": "科技 · 创新 · 活力",
            "title": "让增长跑起来",
            "titleAccent": "跑起来",
            "intro": "硬核底座、灵活编排与看得见的增长闭环。技术够稳，创意够野，结果够快——把复杂的交给平台，把创造与结果留给你。",
            "stats": [
              {
                "value": "99.99%",
                "label": "可用性 · 科技"
              },
              {
                "value": "3.4×",
                "label": "交付提速 · 创新"
              },
              {
                "value": "+218%",
                "label": "增长 · 活力"
              }
            ],
            "media": {
              "src": "/styles/enterprise/media/hero-poster.svg",
              "aspect": "3/2",
              "fit": "contain",
              "badge": "REALTIME · 实时增长"
            }
          }
        },
        {
          "component": "Features"
        },
        {
          "component": "Banner"
        },
        {
          "component": "CTA",
          "props": {
            "title": "想看看我们怎么落地？",
            "buttonLabel": "查看解决方案",
            "href": "/solution"
          }
        },
        {
          "component": "ArticleList"
        }
      ]
    },
    "section": {
      "layout": "page-sidebar-left",
      "hero": {
        "enabled": true,
        "titleFrom": "section",
        "showCover": true,
        "description": true
      },
      "sidebar": {
        "enabled": true,
        "sticky": true
      },
      "list": {
        "layout": "grid",
        "columns": 2,
        "showThumbnail": true,
        "showExcerpt": true,
        "cardStyle": "shadow"
      },
      "subcategory": {
        "enabled": true,
        "position": "top",
        "style": "pill",
        "columns": 3,
        "showCount": true
      }
    },
    "article": {
      "layout": "single",
      "showTOC": true,
      "showAuthor": false,
      "sidebar": "related",
      "maxWidth": 820,
      "hero": "cover"
    },
    "list": {
      "layout": "grid",
      "columns": 2
    },
    "category": {
      "layout": "page-sidebar-left",
      "hero": {
        "enabled": true,
        "titleFrom": "category",
        "showCover": true,
        "description": true
      },
      "sidebar": {
        "enabled": true,
        "sticky": true
      },
      "list": {
        "layout": "grid",
        "columns": 2,
        "showThumbnail": true,
        "showExcerpt": true,
        "cardStyle": "shadow"
      },
      "subcategory": {
        "enabled": true,
        "position": "top",
        "style": "pill",
        "showCount": true
      }
    },
    "templates": {
      "article-list": {
        "columns": 1,
        "gap": "1rem",
        "showThumbnail": true,
        "showExcerpt": true,
        "cardStyle": "shadow"
      },
      "article-grid": {
        "columns": 2,
        "gap": "1.5rem",
        "aspectRatio": "16/9",
        "showThumbnail": true,
        "showExcerpt": true,
        "cardStyle": "shadow"
      },
      "article-masonry": {
        "columns": 2,
        "gap": "1rem",
        "aspectRatio": "auto",
        "showThumbnail": true,
        "showExcerpt": true,
        "cardStyle": "shadow"
      },
      "magazine": {
        "columns": 2,
        "gap": "1.5rem",
        "showThumbnail": true,
        "showExcerpt": true,
        "cardStyle": "shadow"
      },
      "single-page": {
        "maxWidth": 820,
        "centered": true
      },
      "link-wall": {
        "columns": 4,
        "gap": "0.75rem",
        "pill": false
      },
      "design-gallery": {
        "columns": 3,
        "gap": "1rem",
        "aspectRatio": "4/3",
        "cardStyle": "shadow"
      }
    }
  },
  "footer": {
    "variant": "multi-column",
    "padding": "3.5rem 1.25rem 1.75rem",
    "borderTop": "2px solid #F1DCCB",
    "nav": {
      "columns": 4,
      "gap": "2rem 3rem",
      "title": {
        "size": "0.75rem",
        "weight": 800,
        "transform": "uppercase",
        "letterSpacing": "0.12em",
        "marginBottom": "1rem"
      },
      "link": {
        "size": "0.9rem",
        "lineHeight": "2",
        "gap": "0.5rem"
      }
    },
    "friendLinks": {
      "show": false,
      "maxItems": 20
    },
    "bottom": {
      "layout": "between",
      "size": "0.8125rem",
      "divider": "2px solid #F1DCCB",
      "showIcp": true,
      "showPoweredBy": true
    },
    "background": "#FFEDE0",
    "textColor": "#1A1206"
  },
  "features": {
    "readingProgressBar": true,
    "backToTop": true,
    "welcomeOverlay": true,
    "languageSwitcher": "icon"
  }
}
