{
  "homepage": {
    "container": "boxed",
    "sections": [
      { "component":"CustomBlock", "props":{
          "size":"hero",
          "title":"以内容驱动业务持续增长",
          "intro":"聚合团队的知识、作品与洞察，让分散的内容资产变成可被理解、推理并持续产生价值的系统。",
          "cta":  { "label":{"zh":"浏览全部内容","en":"Explore content"}, "href":"/articles", "style":"primary" },
          "cta2": { "label":{"zh":"阅读博客","en":"Read the blog"},       "href":"/blog",     "style":"outline" }
      } },
      { "component":"Features",   "variant":"3-col-cards" },
      { "component":"Banner",      "variant":"cta", "id":"home_main" },
      { "component":"ArticleList","variant":"grid-3", "props":{"source":"latest","limit":6} },
      { "component":"CTA",        "variant":"banner" }
    ]
  },
  "section": {
    "layout": "page-sidebar-left",
    "hero":   { "enabled":true, "titleFrom":"section", "showCover":true, "description":true },
    "sidebar":{
      "enabled":true, "position":"left",
      "source":"categories", "title":"栏目导航", "showCounts":true, "sticky":true,
      "customItems":[]
    },
    "content": { "type":"featured-article", "source":"latest", "articleSlug":"" },
    "list":   { "layout":"grid", "columns":3, "showThumbnail":true, "showExcerpt":true }
  },
  "article": {
    "layout":"single", "showTOC":false, "showAuthor":true,
    "sidebar":"related", "maxWidth":720
  },
  "list": { "layout":"grid", "columns":3 },
  "category": {
    "layout": "page-sidebar-left",
    "hero":   { "enabled":true, "titleFrom":"category", "showCover":true, "description":true },
    "sidebar":{ "enabled":true, "position":"left", "source":"categories", "title":"栏目导航", "showCounts":true, "sticky":true },
    "list":   { "layout":"grid", "columns":3, "showThumbnail":true, "showExcerpt":true }
  },
  "templates": {
    "article-list":    { "columns":1, "gap":"0.75rem", "showThumbnail":true,  "showExcerpt":true,  "cardStyle":"bordered" },
    "article-grid":    { "columns":3, "gap":"1.25rem", "aspectRatio":"4/3",   "showThumbnail":true,  "showExcerpt":true,  "cardStyle":"shadow" },
    "article-masonry": { "columns":3, "gap":"1rem",   "aspectRatio":"auto",  "showThumbnail":true,  "showExcerpt":false, "cardStyle":"clean" },
    "magazine":        { "columns":3, "gap":"1.25rem", "showThumbnail":true,  "showExcerpt":true,  "cardStyle":"shadow" },
    "single-page":     { "maxWidth":820, "centered":true },
    "link-wall":       { "columns":5, "gap":"0.75rem", "pill":true },
    "design-gallery":  { "columns":4, "gap":"1rem",   "aspectRatio":"1/1",   "cardStyle":"zoom" }
  }
}
