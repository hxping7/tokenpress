{
  "variant":"sticky-transparent",
  "logo": {
    "type":"image",
    "src":"/logo-dark.svg",
    "srcLight":"/logo-light.svg",
    "text":"TokenPress",
    "position":"center",
    "height":60,
    "link":"/"
  },
  "nav":  { "align":"center", "style":"underline", "source":"sections", "customItems":[],
    "colors": {
      "text":"var(--text-primary)",
      "hoverBg":"var(--hover-bg)",
      "hoverText":"var(--text-primary)",
      "activeBg":"#ec4899",
      "activeText":"#ffffff",
      "barBg":"transparent",
      "barText":"var(--text-primary)"
    } },
  "actions": [
    { "type":"theme", "icon":"palette", "style":"icon" },
    { "type":"language", "icon":"globe", "style":"pill", "label":{"zh":"中文","en":"EN"} },
    { "type":"admin", "icon":"dashboard", "style":"ghost", "showWhen":"loggedIn" },
    { "type":"logout", "icon":"logout", "style":"ghost", "showWhen":"loggedIn" },
    { "type":"login", "icon":"user", "style":"primary", "showWhen":"loggedOut" }
  ],
  "background":"transparent",
  "borderBottom":"none"
}
