{
  "$": {
    "id": "blog",
    "name": "科技博客（默认）",
    "description": "经典科技博客布局：吸顶 Header、Hero 轮播、文章网格 + 右侧栏板块、双栏文章页。",
    "version": "1.1.0",
    "author": "token00",
    "preview": "/styles/blog/preview.png",
    "builtin": true,
    "defaultTheme": "light",
    "tags": [
      "blog",
      "default",
      "tech"
    ]
  },
  "design": {
    "tokens": {
      "--bg-primary": "#ffffff",
      "--bg-secondary": "#f5f5f7",
      "--bg-tertiary": "#e8e8ed",
      "--text-primary": "#1d1d1f",
      "--text-secondary": "#3a3a3f",
      "--text-muted": "#8a8a8f",
      "--accent-blue": "#0ea5e9",
      "--accent-purple": "#6366f1",
      "--accent-blue-dim": "#0284c7",
      "--border-color": "rgba(0,0,0,0.12)",
      "--hover-bg": "rgba(14,165,233,0.06)",
      "--gradient-from": "#0ea5e9",
      "--gradient-via": "#38bdf8",
      "--gradient-to": "#6366f1",
      "--grid-pattern": "transparent",
      "--selection-bg": "rgba(14,165,233,0.2)",
      "--scrollbar-thumb": "rgba(14,165,233,0.25)",
      "--scrollbar-thumb-hover": "rgba(14,165,233,0.45)",
      "--focus-ring": "rgba(14,165,233,0.5)",
      "--card-border-hover": "rgba(14,165,233,0.3)",
      "--section-divider": "rgba(14,165,233,0.15)",
      "--btn-glow-from": "transparent",
      "--btn-glow-to": "transparent",
      "--content-max-width": "1200px",
      "--reading-max-width": "720px",
      "--header-height": "64px",
      "--brand-font": "Inter, PingFang SC, system-ui, sans-serif",
      "--radius-card": "14px",
      "--shadow-card": "0 1px 3px rgba(0,0,0,0.06)"
    },
    "theme": ":root{\n  --bg-primary:#ffffff;\n  --bg-secondary:#f5f5f7;\n  --bg-tertiary:#e8e8ed;\n  --text-primary:#1d1d1f;\n  --text-secondary:#3a3a3f;\n  --text-muted:#8a8a8f;\n  --accent-blue:#0ea5e9;\n  --accent-purple:#6366f1;\n  --accent-blue-dim:#0284c7;\n  --border-color:rgba(0,0,0,0.12);\n  --hover-bg:rgba(14,165,233,0.06);\n  --gradient-from:#0ea5e9;\n  --gradient-via:#38bdf8;\n  --gradient-to:#6366f1;\n  --content-max-width:1200px;\n  --reading-max-width:720px;\n  --header-height:64px;\n  --brand-font:\"Inter\",\"PingFang SC\",system-ui,sans-serif;\n  --radius-card:14px;\n  --shadow-card:0 1px 3px rgba(0,0,0,0.06);\n}"
  },
  "header": {
    "variant": "sticky-solid",
    "height": 64,
    "logo": {
      "type": "image",
      "src": "/logo-dark.svg",
      "srcLight": "/logo-light.svg",
      "text": "TokenPress",
      "position": "left",
      "height": 36,
      "link": "/"
    },
    "nav": {
      "source": "sections",
      "align": "left",
      "style": "pill",
      "icons": {
        "code": "code",
        "ai": "sparkles",
        "token": "zap",
        "robotics": "bot",
        "github": "github",
        "about": "info",
        "token_plan": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12 2.8 19.5 7.15V16.85L12 21.2 4.5 16.85V7.15Z'/><path d='M13 7.5l-3 4.9h4l-3 4.9'/></svg>",
        "ai_works": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><rect x='3.5' y='4.5' width='17' height='15' rx='2.5'/><path d='M12 8.6 13.2 10.8 15.4 12 13.2 13.2 12 15.4 10.8 13.2 8.6 12 10.8 10.8Z'/></svg>",
        "githubhots": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12 3.5C12.6 6.2 11.4 7.8 9.8 9.5 8.2 11.2 6.9 12.8 6.9 15.1A5.1 5.1 0 0 0 17.1 15.1C17.1 12.6 15.7 11 14.4 9.4 13.8 10.4 13.1 11.1 12.1 11.5 12.6 8.9 12.5 6.3 12 3.5Z'/></svg>",
        "ai_coding": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4.5' width='18' height='15' rx='2.5'/><path d='M7.5 9.3l3.2 2.7-3.2 2.7'/><path d='M13 14.7h3.8'/></svg>",
        "ai_info": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M2.8 12C4.8 8.2 8.2 5.9 12 5.9s7.2 2.3 9.2 6.1c-2 3.8-5.4 6.1-9.2 6.1S4.8 15.8 2.8 12Z'/><circle cx='12' cy='12' r='2.6'/></svg>",
        "ai-info": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M2.8 12C4.8 8.2 8.2 5.9 12 5.9s7.2 2.3 9.2 6.1c-2 3.8-5.4 6.1-9.2 6.1S4.8 15.8 2.8 12Z'/><circle cx='12' cy='12' r='2.6'/></svg>",
        "blog": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='M12 6.6C10.4 5.1 8.3 4.6 5.6 4.6c-.7 0-1.4.1-2 .2V18.2c.6-.1 1.3-.2 2-.2 2.7 0 4.8.6 6.4 2 1.6-1.4 3.7-2 6.4-2 .7 0 1.4.1 2 .2V4.8c-.6-.1-1.3-.2-2-.2-2.7 0-4.8.5-6.4 2Z'/><path d='M12 6.6V20'/></svg>"
      },
      "colors": {
        "text": "#3a3a3f",
        "hoverBg": "rgba(14,165,233,0.08)",
        "hoverText": "#1d1d1f",
        "activeBg": "#0ea5e9",
        "activeText": "#ffffff",
        "barBg": "transparent",
        "barText": "#1d1d1f"
      }
    },
    "actions": [
      {
        "type": "theme",
        "icon": "palette",
        "style": "icon"
      },
      {
        "type": "language",
        "icon": "globe",
        "style": "ghost",
        "label": {
          "zh": "中文",
          "en": "EN"
        }
      }
    ],
    "background": "#ffffff",
    "borderBottom": "1px solid rgba(0,0,0,0.08)"
  },
  "hero": {
    "enabled": true,
    "size": "standard",
    "autoplay": true,
    "interval": 5,
    "showCTA": true,
    "ctaButtons": []
  },
  "layouts": {
    "homepage": {
      "container": "boxed",
      "sections": [
        {
          "component": "Hero",
          "variant": "carousel",
          "props": {
            "autoplay": true
          }
        },
        {
          "component": "Banner",
          "variant": "cta",
          "id": "home_main"
        },
        {
          "component": "ArticleList",
          "variant": "grid-3",
          "props": {
            "source": "latest",
            "limit": 9
          }
        },
        {
          "component": "Banner",
          "variant": "cta",
          "id": "home_bottom"
        }
      ]
    },
    "section": {
      "layout": "page-sidebar-right",
      "hero": {
        "enabled": false
      },
      "sidebar": {
        "enabled": true,
        "sticky": true
      },
      "list": {
        "layout": "grid",
        "columns": 3,
        "showThumbnail": true,
        "showExcerpt": true
      },
      "subcategory": {
        "enabled": true,
        "position": "sidebar",
        "style": "list",
        "columns": 3,
        "showCount": true
      }
    },
    "article": {
      "layout": "two-column",
      "showTOC": true,
      "showAuthor": true,
      "sidebar": "related",
      "maxWidth": 720
    },
    "list": {
      "layout": "grid",
      "columns": 3
    },
    "category": {
      "layout": "page-sidebar-right",
      "hero": {
        "enabled": true,
        "titleFrom": "category",
        "showCover": false,
        "description": true
      },
      "sidebar": {
        "enabled": true,
        "sticky": true
      },
      "list": {
        "layout": "grid",
        "columns": 3,
        "showThumbnail": true,
        "showExcerpt": true
      },
      "subcategory": {
        "enabled": true,
        "position": "sidebar",
        "style": "list",
        "showCount": true
      }
    },
    "templates": {
      "article-list": {
        "columns": 1,
        "gap": "1rem",
        "showThumbnail": true,
        "showExcerpt": true,
        "cardStyle": "clean"
      },
      "article-grid": {
        "columns": 3,
        "gap": "1.5rem",
        "aspectRatio": "40/21",
        "showThumbnail": true,
        "showExcerpt": true,
        "cardStyle": "bordered"
      },
      "article-masonry": {
        "columns": 2,
        "gap": "1rem",
        "aspectRatio": "auto",
        "showThumbnail": true,
        "showExcerpt": false,
        "cardStyle": "clean"
      },
      "magazine": {
        "columns": 3,
        "gap": "1.5rem",
        "showThumbnail": true,
        "showExcerpt": true,
        "cardStyle": "bordered"
      },
      "single-page": {
        "maxWidth": 760,
        "centered": true
      },
      "link-wall": {
        "columns": 4,
        "gap": "0.75rem",
        "pill": true
      },
      "design-gallery": {
        "columns": 3,
        "gap": "1rem",
        "aspectRatio": "4/3",
        "cardStyle": "clean"
      }
    }
  },
  "footer": {
    "variant": "multi-column",
    "padding": "2.5rem 1.25rem",
    "borderTop": "1px solid var(--border-color)",
    "nav": {
      "columns": 3,
      "gap": "2rem 3rem",
      "title": {
        "size": "0.875rem",
        "weight": 600,
        "marginBottom": "0.75rem"
      },
      "link": {
        "size": "0.875rem",
        "lineHeight": "1.9",
        "gap": "0.625rem"
      }
    },
    "friendLinks": {
      "show": true,
      "layout": "inline",
      "gap": "1.5rem",
      "maxItems": 20
    },
    "bottom": {
      "layout": "columns",
      "size": "0.75rem",
      "showIcp": true,
      "showPoweredBy": true
    },
    "background": "var(--bg-secondary)",
    "textColor": "var(--text-secondary)"
  },
  "features": {
    "readingProgressBar": true,
    "backToTop": true,
    "welcomeOverlay": true,
    "languageSwitcher": "icon"
  }
}
