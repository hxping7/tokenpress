{
  "homepage": {
    "container": "boxed",
    "sections": [
      { "component":"Hero",        "variant":"carousel", "props":{"autoplay":true} },
      { "component":"Banner",      "variant":"cta", "id":"home_main" },
      { "component":"ArticleList", "variant":"grid-3",   "props":{"source":"latest","limit":9} },
      { "component":"Banner",      "variant":"cta", "id":"home_bottom" }
    ]
  },
  "section": {
    "layout": "page-sidebar-right",
    "hero":   { "enabled":false },
    "sidebar":{ "enabled":true, "sticky":true },
    "list":   { "layout":"grid", "columns":3, "showThumbnail":true, "showExcerpt":true }
  },
  "article": {
    "layout":"two-column", "showTOC":true, "showAuthor":true,
    "sidebar":"related", "maxWidth":720
  },
  "list": { "layout":"grid", "columns":3 },
  "category": {
    "layout": "page-sidebar-right",
    "hero":   { "enabled":true, "titleFrom":"category", "showCover":false, "description":true },
    "sidebar":{ "enabled":true, "sticky":true },
    "list":   { "layout":"grid", "columns":3, "showThumbnail":true, "showExcerpt":true }
  },
  "templates": {
    "article-list":    { "columns":1, "gap":"1rem",   "showThumbnail":true,  "showExcerpt":true,  "cardStyle":"clean" },
    "article-grid":    { "columns":3, "gap":"1.5rem", "aspectRatio":"16/10", "showThumbnail":true,  "showExcerpt":true,  "cardStyle":"bordered" },
    "article-masonry": { "columns":2, "gap":"1rem",   "aspectRatio":"auto",  "showThumbnail":true,  "showExcerpt":false, "cardStyle":"clean" },
    "magazine":        { "columns":3, "gap":"1.5rem", "showThumbnail":true,  "showExcerpt":true,  "cardStyle":"bordered" },
    "single-page":     { "maxWidth":760, "centered":true },
    "link-wall":       { "columns":4, "gap":"0.75rem", "pill":true },
    "design-gallery":  { "columns":3, "gap":"1rem",   "aspectRatio":"4/3",   "cardStyle":"clean" }
  }
}
